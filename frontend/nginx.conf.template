# SATYAMEBA edge proxy + SPA host  (rendered from this template at container
# start so ${SAT_MAX_UPLOAD} is configurable). This is the ONLY container that
# publishes ports (80/443); everything else stays on the internal network.

worker_processes auto;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    client_max_body_size ${SAT_MAX_UPLOAD};   # 0 = unlimited (default); set e.g. 10g to cap
    proxy_request_buffering off;               # stream large uploads straight through
    keepalive_timeout 65;

    # Re-resolve service names at runtime (Docker DNS) so a recreated container
    # with a new IP doesn't leave us hitting a stale address (502s).
    resolver 127.0.0.11 valid=10s ipv6=off;

    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=3r/s;

    map $http_upgrade $connection_upgrade { default upgrade; "" close; }

    # ---- HTTP : ACME + health + redirect to HTTPS ---------------------------
    server {
        listen 80;
        server_name _;
        location = /edge-health { access_log off; return 200 "ok\n"; }   # healthcheck
        location /.well-known/acme-challenge/ { root /var/www/certbot; }
        location / { return 301 https://$host$request_uri; }
    }

    # ---- HTTPS --------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name _;

        ssl_certificate     /etc/nginx/certs/satyameba.crt;
        ssl_certificate_key /etc/nginx/certs/satyameba.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;

        root /usr/share/nginx/html;
        index index.html;
        location / {
            try_files $uri $uri/ /index.html;
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        }

        # Internal-only gateway endpoints must never be reachable from outside.
        location /api/internal/ { return 404; }

        # SSO handoff carries a one-time token in the URL — don't log it.
        location = /hub/sso-login {
            access_log off;
            set $hub jupyterhub;
            proxy_pass http://$hub:8000;
            include /etc/nginx/proxy_ws.conf;
        }

        # --- gateway API (variable upstream forces per-request DNS) ---
        location /api/auth/ {
            limit_req zone=auth burst=5 nodelay;
            set $gw gateway;
            proxy_pass http://$gw:8000;
            include /etc/nginx/proxy_common.conf;
        }
        location /api/ {
            limit_req zone=api burst=40 nodelay;
            set $gw gateway;
            proxy_pass http://$gw:8000;
            include /etc/nginx/proxy_common.conf;
        }
        location = /healthz {
            set $gw gateway;
            proxy_pass http://$gw:8000;
            include /etc/nginx/proxy_common.conf;
        }

        # --- JupyterHub (notebooks) with websocket upgrade ---
        location /hub/  { set $hub jupyterhub; proxy_pass http://$hub:8000; include /etc/nginx/proxy_ws.conf; }
        location /user/ { set $hub jupyterhub; proxy_pass http://$hub:8000; include /etc/nginx/proxy_ws.conf; }

        # --- Grafana (served under its own /grafana sub-path) ---
        location /grafana/ {
            set $graf grafana;
            proxy_pass http://$graf:3000;
            include /etc/nginx/proxy_ws.conf;
        }
    }
}
