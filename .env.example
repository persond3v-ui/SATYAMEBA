# ============================================================================
# SATYAMEBA environment — copy to .env (the setup script generates one for you)
# Every CHANGE_ME / secret below is regenerated by setup/satyameba_setup.py.
# ============================================================================

# --- core ---
SAT_ENVIRONMENT=production
SAT_PROJECT_NAME=SATYAMEBA
SAT_OWNER=Samaraho Mukherjee

# --- database ---
POSTGRES_USER=satyameba
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=satyameba
SAT_DATABASE_URL=postgresql+psycopg2://satyameba:CHANGE_ME_db_password@db:5432/satyameba

# --- JWT (RS256). The setup script writes the PEM keypair into ./secrets/. ---
SAT_JWT_ALGORITHM=RS256
SAT_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
SAT_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
SAT_ACCESS_TOKEN_TTL_SECONDS=900
SAT_REFRESH_TOKEN_TTL_SECONDS=604800

# --- request signing ---
SAT_REQUEST_SIGNING_ENABLED=true
SAT_REQUEST_SIGNING_SKEW_SECONDS=120

# --- bootstrap admin (created on first start) ---
SAT_BOOTSTRAP_ADMIN_EMAIL=admin@satyameba.local
SAT_BOOTSTRAP_ADMIN_USERNAME=admin
SAT_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- jupyterhub integration ---
SAT_HUB_API_URL=http://jupyterhub:8081/hub/api
SAT_HUB_API_TOKEN=CHANGE_ME_hub_api_token
SAT_HUB_PUBLIC_URL=/hub
SAT_INTERNAL_SHARED_SECRET=CHANGE_ME_internal_secret

# --- jupyterhub runtime (consumed by the hub container) ---
SAT_SPAWNER=docker
SAT_NOTEBOOK_IMAGE=satyameba/notebook:latest
SAT_NETWORK=satyameba_net
SAT_GPU_ENABLED=false
SAT_MEM_LIMIT=4G
SAT_CPU_LIMIT=2

# --- security knobs ---
SAT_CORS_ORIGINS=https://localhost,https://satyameba.local
SAT_RATE_LIMIT_PER_MINUTE=120
SAT_AUTH_RATE_LIMIT_PER_MINUTE=10
SAT_BOT_FILTER_ENABLED=true

# --- grafana ---
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_password
